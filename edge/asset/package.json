{
  "name": "@the-drunken-coder/atlas-asset",
  "version": "0.1.0",
  "description": "Ground-hosted Atlas Asset for one ArduPilot quadcopter over a serial SiK MAVLink link (macOS).",
  "author": "the-Drunken-coder",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atlas-asset": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --config-path biome.json .",
    "format": "biome check --write .",
    "format:check": "biome check --linter-enabled=false .",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@the-drunken-coder/atlas-sdk": "0.1.0",
    "node-mavlink": "2.3.0",
    "serialport": "13.0.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
