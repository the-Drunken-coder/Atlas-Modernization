{
  "name": "atlas-core",
  "version": "0.1.7",
  "atlasCoreImage": "ghcr.io/the-drunken-coder/atlas-core@sha256:c4a132a953edc8675e34d6838771a374edd71cf5ea5196db5aa745637db1fef1",
  "atlasPluginImages": {
    "building_scan": "ghcr.io/the-drunken-coder/atlas-building-scan@sha256:3bb8c7d7761c71fa1a9fb399b275a26686b2c7d39b9be2a2292797284f2f2b25"
  },
  "description": "Install and operate a durable Atlas Core deployment with Docker Compose.",
  "author": "the-Drunken-coder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-Drunken-coder/Atlas-Modernization.git",
    "directory": "surfaces/core-cli"
  },
  "homepage": "https://github.com/the-Drunken-coder/Atlas-Modernization/tree/main/surfaces/core-cli#readme",
  "bugs": {
    "url": "https://github.com/the-Drunken-coder/Atlas-Modernization/issues"
  },
  "keywords": [
    "atlas",
    "atlas-core",
    "docker",
    "operations"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "assets/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "atlas-core": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "node scripts/generate-package-metadata.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --config-path biome.json .",
    "format:check": "biome check --linter-enabled=false --config-path biome.json .",
    "test": "vitest run",
    "test:package": "node test/packed-install-smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8",
    "wrap-ansi": "10.0.1"
  }
}
