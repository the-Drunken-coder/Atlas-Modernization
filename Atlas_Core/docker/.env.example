# Copy to .env next to docker-compose.yml and adjust. Docker Compose loads .env automatically.
# Required for MinIO services (see docker-compose.yml).
MINIO_ROOT_PASSWORD=change-me

# Optional: Postgres password (default in compose is "atlas").
# POSTGRES_PASSWORD=atlas

# Optional: set to true|1|yes|on to run `mc anonymous set download` on atlas-media (dev-only).
# ENABLE_PUBLIC_MINIO=false
