# Copy to .env next to docker-compose.yml and adjust. Docker Compose loads .env automatically.
# Required for MinIO services (see docker-compose.yml).
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Required for Postgres and the API database URL.
# Atlas Core treats this database as disposable runtime state; default startup
# recreates tables instead of preserving row history.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional for local compose; required for production mode and tunnel mode.
# ENABLE_API_AUTH=false
# API_AUTH_KEY=REPLACE_WITH_SECURE_KEY
# ATLAS_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD

# Required only when using Cloudflare Tunnel.
# CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
# Optional: public hostname used by atlas.py tunnel verification and manual remote tests.
# ATLAS_TUNNEL_HOSTNAME=atlascommandapi.org
# Optional: full URL override for scripts/test_api_manual.py --remote.
# api.atlasinterface.com can be added as a same-site browser alias once DNS points it at the same tunnel.
# ATLAS_API_REMOTE_URL=https://atlascommandapi.org
# Browser origins allowed to use cookie-authenticated Core APIs.
CORS_ORIGINS=https://atlasinterface.com
# Optional browser origin patterns allowed for trusted preview deployments you control.
CORS_ORIGIN_PATTERNS=https://*.atlas-je0.pages.dev

# Optional API database pool tuning.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_IDLE_TIMEOUT=600
DATABASE_POOL_PRE_PING=true

# Optional: set to true|1|yes|on to run `mc anonymous set download` on atlas-media (dev-only).
# ENABLE_PUBLIC_MINIO=false
