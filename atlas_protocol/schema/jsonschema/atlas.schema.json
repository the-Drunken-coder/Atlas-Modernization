{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.schema.json",
  "$comment": "Atlas Protocol canonical JSON Schema source. Edit this file and run go run ./tools/generate.",
  "$defs": {
    "CircleProperties": {
      "additionalProperties": false,
      "properties": {
        "radius_m": {
          "$ref": "#/$defs/FiniteNumber",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "shape": {
          "const": "circle"
        }
      },
      "required": [
        "radius_m",
        "shape"
      ],
      "type": "object"
    },
    "Classification": {
      "enum": [
        "friendly",
        "hostile",
        "neutral",
        "unknown",
        "civilian"
      ]
    },
    "CommandComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "parameters": {
          "$ref": "#/$defs/JSONValue"
        },
        "target": {
          "$ref": "#/$defs/JSONValue"
        },
        "type": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CommunicationsComponent": {
      "additionalProperties": false,
      "properties": {
        "link_state": {
          "$ref": "#/$defs/LinkState"
        }
      },
      "type": "object"
    },
    "EntityBlob": {
      "additionalProperties": {
        "$ref": "#/$defs/JSONValue"
      },
      "properties": {
        "components": {
          "$ref": "#/$defs/EntityComponents",
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "published_at": {
          "$ref": "#/$defs/RFC3339Timestamp"
        }
      },
      "type": "object"
    },
    "EntityComponents": {
      "additionalProperties": false,
      "patternProperties": {
        "^custom_": {
          "$ref": "#/$defs/JSONValue"
        }
      },
      "properties": {
        "communications": {
          "$ref": "#/$defs/CommunicationsComponent"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryComponent"
        },
        "health": {
          "$ref": "#/$defs/HealthComponent"
        },
        "heartbeat": {
          "$ref": "#/$defs/HeartbeatComponent"
        },
        "media_refs": {
          "$ref": "#/$defs/MediaRefsComponent"
        },
        "mil_view": {
          "$ref": "#/$defs/MilViewComponent"
        },
        "sensor_refs": {
          "$ref": "#/$defs/SensorRefsComponent"
        },
        "status": {
          "$ref": "#/$defs/StatusComponent"
        },
        "task_catalog": {
          "$ref": "#/$defs/TaskCatalogComponent"
        },
        "task_queue": {
          "$ref": "#/$defs/TaskQueueComponent"
        },
        "telemetry": {
          "$ref": "#/$defs/TelemetryComponent"
        }
      },
      "type": "object"
    },
    "EntityCreateEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "create"
        },
        "id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/EntityResource"
        },
        "resource_type": {
          "const": "entity"
        },
        "version": {
          "$ref": "#/$defs/FeedVersion"
        }
      },
      "required": [
        "event",
        "id",
        "resource",
        "resource_type",
        "version"
      ],
      "type": "object"
    },
    "EntityCreateRequest": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NonEmptyString",
              "maxLength": 255,
              "type": "string"
            }
          ]
        },
        "components": {
          "$ref": "#/$defs/EntityComponents"
        },
        "entity_id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "published_at": {
          "$ref": "#/$defs/RFC3339Timestamp"
        },
        "subtype": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/RFC3339Timestamp"
        }
      },
      "required": [
        "entity_id",
        "entity_type"
      ],
      "type": "object"
    },
    "EntityDeleteEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "delete"
        },
        "id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "resource_type": {
          "const": "entity"
        },
        "version": {
          "$ref": "#/$defs/FeedVersion"
        }
      },
      "required": [
        "event",
        "id",
        "resource_type",
        "version"
      ],
      "type": "object"
    },
    "EntityResource": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NonEmptyString",
              "maxLength": 255,
              "type": "string"
            }
          ]
        },
        "components": {
          "$ref": "#/$defs/EntityComponents"
        },
        "entity_id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataBlock"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NonEmptyString",
              "maxLength": 50,
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "alias",
        "components",
        "entity_id",
        "entity_type",
        "metadata",
        "subtype"
      ],
      "type": "object"
    },
    "EntityUpdateEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "update"
        },
        "id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/EntityResource"
        },
        "resource_type": {
          "const": "entity"
        },
        "version": {
          "$ref": "#/$defs/FeedVersion"
        }
      },
      "required": [
        "event",
        "id",
        "resource",
        "resource_type",
        "version"
      ],
      "type": "object"
    },
    "EntityUpdateRequest": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "alias": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NonEmptyString",
              "maxLength": 255,
              "type": "string"
            }
          ]
        },
        "components": {
          "$ref": "#/$defs/EntityComponents"
        },
        "entity_type": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NonEmptyString",
              "maxLength": 50,
              "type": "string"
            }
          ]
        }
      },
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "VALIDATION_ERROR",
        "INVALID_JSON",
        "BODY_TOO_LARGE",
        "INVALID_FORM",
        "UNAUTHORIZED",
        "TOO_MANY_ATTEMPTS",
        "FEED_UNAVAILABLE",
        "STORAGE_UNAVAILABLE",
        "STORAGE_ERROR",
        "CONTENT_TYPE_NOT_VIEWABLE",
        "FILE_TOO_LARGE",
        "READ_ERROR",
        "INTERNAL_SERVER_ERROR",
        "ENTITY_NOT_FOUND",
        "ENTITY_ALIAS_NOT_FOUND",
        "TASK_NOT_FOUND",
        "OBJECT_NOT_FOUND",
        "BUCKET_NOT_FOUND",
        "ENTITY_ALREADY_EXISTS",
        "TASK_ALREADY_EXISTS",
        "OBJECT_ALREADY_EXISTS",
        "OBJECT_PATH_CONFLICT",
        "PRECONDITION_FAILED"
      ]
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "error_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "message": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "path": {
          "type": "string"
        },
        "success": {
          "const": false
        },
        "timestamp": {
          "$ref": "#/$defs/RFC3339Timestamp"
        }
      },
      "required": [
        "error_code",
        "message",
        "success"
      ],
      "type": "object"
    },
    "FeedAuthMessage": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "auth"
        },
        "api_key": {
          "$ref": "#/$defs/NonEmptyString",
          "description": "Sensitive credential material. Producers and consumers must not log,\necho, or expose this value in error responses or debug output."
        }
      },
      "required": [
        "action",
        "api_key"
      ],
      "type": "object"
    },
    "FeedClientMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeedAuthMessage"
        },
        {
          "$ref": "#/$defs/FeedSubscribeMessage"
        },
        {
          "$ref": "#/$defs/FeedUnsubscribeMessage"
        }
      ]
    },
    "FeedEvent": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityCreateEvent"
        },
        {
          "$ref": "#/$defs/EntityUpdateEvent"
        },
        {
          "$ref": "#/$defs/TaskCreateEvent"
        },
        {
          "$ref": "#/$defs/TaskUpdateEvent"
        },
        {
          "$ref": "#/$defs/ObjectCreateEvent"
        },
        {
          "$ref": "#/$defs/ObjectUpdateEvent"
        },
        {
          "$ref": "#/$defs/EntityDeleteEvent"
        },
        {
          "$ref": "#/$defs/TaskDeleteEvent"
        },
        {
          "$ref": "#/$defs/ObjectDeleteEvent"
        }
      ]
    },
    "FeedHandshakeMessage": {
      "additionalProperties": false,
      "properties": {
        "protocol_revision": {
          "$ref": "#/$defs/ProtocolRevision"
        },
        "type": {
          "const": "hello"
        }
      },
      "required": [
        "protocol_revision",
        "type"
      ],
      "type": "object"
    },
    "FeedSubscribeMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubscribeAllMessage"
        },
        {
          "$ref": "#/$defs/SubscribeIDMessage"
        },
        {
          "$ref": "#/$defs/SubscribeTypeMessage"
        },
        {
          "$ref": "#/$defs/SubscribeTasksForEntityMessage"
        }
      ]
    },
    "FeedUnsubscribeMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnsubscribeAllMessage"
        },
        {
          "$ref": "#/$defs/UnsubscribeIDMessage"
        },
        {
          "$ref": "#/$defs/UnsubscribeTypeMessage"
        },
        {
          "$ref": "#/$defs/UnsubscribeTasksForEntityMessage"
        }
      ]
    },
    "FeedVersion": {
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "GeoJSONCircleFeature": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "$ref": "#/$defs/GeoJSONPoint"
        },
        "properties": {
          "$ref": "#/$defs/CircleProperties"
        },
        "type": {
          "const": "Feature"
        }
      },
      "required": [
        "geometry",
        "properties",
        "type"
      ],
      "type": "object"
    },
    "GeoJSONLineString": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "$ref": "#/$defs/GeoJSONPosition"
          },
          "maxItems": 10000,
          "minItems": 2,
          "type": "array"
        },
        "type": {
          "const": "LineString"
        }
      },
      "required": [
        "coordinates",
        "type"
      ],
      "type": "object"
    },
    "GeoJSONPoint": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "$ref": "#/$defs/GeoJSONPosition"
        },
        "type": {
          "const": "Point"
        }
      },
      "required": [
        "coordinates",
        "type"
      ],
      "type": "object"
    },
    "GeoJSONPolygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "$ref": "#/$defs/GeoJSONPosition"
            },
            "minItems": 4,
            "type": "array"
          },
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "Polygon"
        }
      },
      "required": [
        "coordinates",
        "type"
      ],
      "type": "object"
    },
    "GeoJSONPosition": {
      "items": {
        "$ref": "#/$defs/FiniteNumber"
      },
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Longitude"
        },
        {
          "$ref": "#/$defs/Latitude"
        }
      ],
      "type": "array"
    },
    "GeometryComponent": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeoJSONPoint"
        },
        {
          "$ref": "#/$defs/GeoJSONLineString"
        },
        {
          "$ref": "#/$defs/GeoJSONPolygon"
        },
        {
          "$ref": "#/$defs/GeoJSONCircleFeature"
        }
      ]
    },
    "HealthComponent": {
      "additionalProperties": false,
      "properties": {
        "battery_percent": {
          "$ref": "#/$defs/FiniteNumber",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "HeartbeatComponent": {
      "additionalProperties": false,
      "properties": {
        "last_seen": {
          "$ref": "#/$defs/RFC3339Timestamp"
        }
      },
      "required": [
        "last_seen"
      ],
      "type": "object"
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        }
      ]
    },
    "Latitude": {
      "$ref": "#/$defs/FiniteNumber",
      "maximum": 90,
      "minimum": -90,
      "type": "number"
    },
    "LinkState": {
      "enum": [
        "connected",
        "disconnected",
        "degraded",
        "unknown"
      ]
    },
    "Longitude": {
      "$ref": "#/$defs/FiniteNumber",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
    },
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/MediaRole"
        }
      },
      "required": [
        "object_id",
        "role"
      ],
      "type": "object"
    },
    "MediaRefsComponent": {
      "items": {
        "$ref": "#/$defs/MediaRef"
      },
      "type": "array"
    },
    "MediaRole": {
      "enum": [
        "camera_feed",
        "thumbnail",
        "heatmap_data"
      ]
    },
    "MetadataBlock": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "$ref": "#/$defs/RFC3339Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/RFC3339Timestamp"
        },
        "version": {
          "$ref": "#/$defs/FeedVersion"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "version"
      ],
      "type": "object"
    },
    "MilViewComponent": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "last_seen": {
          "$ref": "#/$defs/RFC3339Timestamp"
        }
      },
      "type": "object"
    },
    "NonEmptyString": {
      "pattern": "\\S",
      "type": "string"
    },
    "ObjectBlob": {
      "additionalProperties": {
        "$ref": "#/$defs/JSONValue"
      },
      "properties": {
        "bucket": {
          "type": "string"
        },
        "referenced_by": {
          "items": {
            "$ref": "#/$defs/ObjectReference"
          },
          "type": "array"
        },
        "size_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "usage_hints": {
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ObjectCreateEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "create"
        },
        "id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ObjectResource"
        },
        "resource_type": {
          "const": "object"
        },
        "version": {
          "$ref": "#/$defs/FeedVersion"
        }
      },
      "required": [
        "event",
        "id",
        "resource",
        "resource_type",
        "version"
      ],
      "type": "object"
    },
    "ObjectCreateRequest": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "maxLength": 100,
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "object_id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "type": "string"
        },
        "referenced_by": {
          "items": {
            "$ref": "#/$defs/ObjectReference"
          },
          "type": "array"
        },
        "size_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "maxLength": 50,
          "type": "string"
        },
        "usage_hints": {
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "type": "array"
        }
      },
      "required": [
        "object_id"
      ],
      "type": "object"
    },
    "ObjectDeleteEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "delete"
        },
        "id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "resource_type": {
          "const": "object"
        },
        "version": {
          "$ref": "#/$defs/FeedVersion"
        }
      },
      "required": [
        "event",
        "id",
        "resource_type",
        "version"
      ],
      "type": "object"
    },
    "ObjectReference": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "task_id": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "type": "object"
    },
    "ObjectDetailResource": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "content_type": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 100,
              "type": "string"
            }
          ]
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataBlock"
        },
        "object_id": {
          "$ref": "#/$defs/NonEmptyString",
          "maxLength": 50,
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 500,
              "type": "string"
            }
          ]
        },
        "referenced_by": {
          "items": {
            "$ref": "#/$defs/ObjectReference"
          },
          "type": "array"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          ]
        },
        "type": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 50,
              "type": "string"
            }
          ]
        },
        "usage_hints": {
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "type": "array"
        }
      },
      "required": [
        "bucket",
        "content_type",
        "extra",
        "metadata",
        "object_id",
        "path",
        "size_bytes",
        "type",
        "usage_hints"
      ],
      "type": "object"
    },
    "ObjectResource": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "content_type": {
          "anyOf": [
            {
              "type": "null"
            },
