{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "root": true,
  "extends": ["../biome.json"],
  "files": {
    "includes": ["**/*.{js,mjs,cjs,ts,tsx}", "!src/package-metadata.ts"]
  },
  "vcs": {
    "root": ".."
  },
  "overrides": [
    {
      "includes": ["src/feed-connection.ts", "src/sync-engine.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    }
  ]
}
