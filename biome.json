{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "origin/main"
  },
  "files": {
    "includes": [
      "atlas_sdk/**/*.{js,mjs,cjs,ts,tsx}",
      "atlas_asset_runtime/**/*.{js,mjs,cjs,ts,tsx}",
      "atlas_command_interface/**/*.{js,mjs,cjs,ts,tsx}",
      "atlas_simulations/**/*.{js,mjs,cjs,ts,tsx}",
      "!atlas_sdk/src/package-metadata.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noConstantCondition": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnsafeFinally": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false
          }
        },
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noCatchAssign": "error",
        "noCompareNegZero": "error",
        "noDoubleEquals": "error",
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noPrototypeBuiltins": "error",
        "noSelfCompare": "error",
        "useDefaultSwitchClauseLast": "error"
      }
    }
  }
}
