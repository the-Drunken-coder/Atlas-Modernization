{
  "name": "@the-drunken-coder/atlas-simulations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Atlas simulation workbench.",
  "exports": {
    "./server": "./src/server/public.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint --config-path biome.json .",
    "format:check": "biome check --linter-enabled=false .",
    "test": "vitest run"
  },
  "dependencies": {
    "@the-drunken-coder/atlas-sdk": "0.1.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
