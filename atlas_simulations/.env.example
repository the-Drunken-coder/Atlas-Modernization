ATLAS_BASE_URL=http://localhost:8000
ATLAS_LOCAL_BASE_URL=http://localhost:8000
ATLAS_SIM_TARGET=local
ATLAS_SIM_PORT=5180

# atlas.py --dev generates the local machine key in Atlas_Core/docker/.env.local.
# The simulations server reads that owner-only file automatically.
# ATLAS_LOCAL_API_KEY=replace-only-for-a-custom-loopback-core

# Deployed Core is disabled unless all required values are explicitly enabled.
# ATLAS_SIM_ENABLE_DEPLOYED=true
# ATLAS_DEPLOYED_BASE_URL=https://api.atlasinterface.com
# ATLAS_DEPLOYED_API_KEY=replace-with-deployed-core-key
