{
  "name": "@the-drunken-coder/atlas-command-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker-hosted Atlas Command interface.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "wrangler types",
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "pretest": "wrangler types",
    "test": "vitest run",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf:types": "wrangler types"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
