{
  "name": "@the-drunken-coder/atlas-command-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker-hosted Atlas Command map console.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prebuild": "wrangler types",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "build:web": "vite build",
    "preview": "vite preview",
    "pretest": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sidc-kit": "^0.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
