{
  "name": "@the-drunken-coder/atlas-command-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages-hosted Atlas Command map console.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format:check": "biome format --changed --no-errors-on-unmatched .",
    "deploy:pages": "npm run build && wrangler pages deploy dist/client --project-name atlas"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sidc-kit": "^0.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
