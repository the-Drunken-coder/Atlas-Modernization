{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "root": true,
  "extends": ["../biome.json"],
  "files": {
    "includes": ["**/*.{js,mjs,cjs,ts,tsx}"]
  },
  "vcs": {
    "root": ".."
  },
  "linter": {
    "domains": {
      "types": "recommended"
    },
    "rules": {
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/map/use-map-reticle-interaction.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    }
  ]
}
