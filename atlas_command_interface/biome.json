{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "root": true,
  "extends": ["../biome.json"],
  "files": {
    "includes": ["**/*.{js,mjs,cjs,ts,tsx}"]
  },
  "vcs": {
    "root": ".."
  },
  "linter": {
    "domains": {
      "types": "recommended"
    },
    "rules": {
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  }
}
