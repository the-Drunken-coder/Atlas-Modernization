# ==============================================================================
# Atlas Modernization
# Go service (atlas_core/) with Python tooling under atlas_core/scripts/.
# This lives at the repo root and applies to the entire tree.
# ==============================================================================

# --- OS / editor noise ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# --- Secrets & local config (never commit) ---
.env
.env.*
!.env.example
atlas_core.settings.json
!atlas_core.settings.json.example
docker-compose.override.yml
# Cloudflare tunnel credentials
**/cloudflared/credentials/*.json
**/cloudflared/credentials/*.pem

# --- Go ---
# Compiled objects / platform binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
# Built service binary (anchored so cmd/atlas_core/ source is kept)
/atlas_core/atlas_core
# Test binaries and coverage output
*.test
*.out
coverage.html
# Go workspace files (machine-specific)
go.work
go.work.sum
# Vendored dependencies (we use modules, not vendoring)
vendor/

# --- JavaScript / TypeScript SDK ---
node_modules/
coverage/
/atlas_sdk/dist/
/atlas_asset_runtime/dist/
/atlas_command_interface/dist/
/atlas_command_interface/storybook-static/
/atlas_command_interface/.wrangler/
/atlas_command_interface/.dev.vars*
/atlas_command_interface/worker-configuration.d.ts
/atlas_simulations/dist/
/atlas_simulations/.atlas-simulations/

# --- Python tooling (atlas_core/scripts/) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# --- Logs / temp ---
logs/
*.log
*.tmp
*.temp

# --- Agent / personal tooling ---
.claude/
.benchmarks/
